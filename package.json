{
  "name": "csv-chat-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:app": ".venv/bin/python tools/dev.py",
    "db:init": ".venv/bin/python tools/local_db.py init",
    "db:start": ".venv/bin/python tools/local_db.py start",
    "db:seed": ".venv/bin/python tools/local_db.py seed",
    "db:status": ".venv/bin/python tools/local_db.py status",
    "db:stop": ".venv/bin/python tools/local_db.py stop",
    "db:urls": ".venv/bin/python tools/local_db.py urls",
    "check:setup": ".venv/bin/python tools/check_setup.py",
    "rescan:context": ".venv/bin/python tools/rescan_context.py",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "generate:api-types": ".venv/bin/python tools/export_openapi.py .openapi/openapi.json && openapi-typescript .openapi/openapi.json -o src/api-types.ts",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
