# CSV Chat local configuration.
#
# Copy this file to .env and edit the values. The real .env file is ignored by git.

# Required: Postgres connection string for a read-only database user.
# The app scans schema metadata and runs exports through this connection.
DATABASE_URL=postgresql://readonly:password@localhost:5432/appdb

# Option A: OpenRouter.
# You can change the model after calibration. Keep temperature at 0 for repeatable behavior.
WORKER_LLM_PROVIDER=openrouter
WORKER_OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=your-api-key

# Option B: Custom OpenAI-compatible endpoint.
# Leave these commented unless you are using a local or internal compatible endpoint.
# MODEL_NAME=openai/gpt-4.1-mini
# MODEL_API_KEY=your-api-key
# MODEL_BASE_URL=http://127.0.0.1:4010/v1

MODEL_TEMPERATURE=0
